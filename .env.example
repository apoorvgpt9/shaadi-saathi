# Server-side only. Never expose this key to the browser.
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=
# Default Claude model for every AI route.
ANTHROPIC_MODEL=claude-opus-5-5
# Optional per-route overrides (intake, ideas, vendors, change, quote, tradeoffs), e.g. the live app runs:
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_CHANGE=claude-opus-5-5
# ANTHROPIC_MODEL_TRADEOFFS=claude-opus-5-5
